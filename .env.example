# Copy to .env for local settings. Never commit .env or a real API key.
# Existing shell variables take priority over values in .env.
ASSISTANT_DATA_DIR=data
LLM_PROVIDER=stub
# Stub mode needs no key. Other providers require a key in your local environment.
LLM_API_KEY=
CREDIT_RATE_VND=450000
RETAKE_MULTIPLIER=1.5
MAX_CREDITS=30
LOG_LEVEL=INFO
